# Based on oh-my-zsh gnzh theme

setopt prompt_subst

# Format command duration in a human readable way.
# For sub-second durations show increasing decimal precision until the value reaches 1.
_jezek_format_duration() {
  local sec=${1:-0}
  if (( sec < 0 )); then
    sec=0
  fi

  if (( sec < 1 )); then
    local precision=1
    local threshold=0.1
    local max_precision=6
    while (( precision < max_precision && sec < threshold )); do
      precision=$(( precision + 1 ))
      threshold=$(( threshold / 10 ))
    done
    local formatted
    formatted=$(LC_NUMERIC=C printf "%.*f" $precision "$sec")
    echo "${formatted}s"
  elif (( sec < 60 )); then
    local seconds=${sec%.*}
    echo "${seconds}s"
  elif (( sec < 3600 )); then
    local total=${sec%.*}
    local m=$(( total / 60 ))
    local s=$(( total % 60 ))
    echo "${m}m${s}s"
  else
    local total=${sec%.*}
    local h=$(( total / 3600 ))
    local m=$(( (total % 3600) / 60 ))
    local s=$(( total % 60 ))
    echo "${h}h${m}m${s}s"
  fi
}

# Compute Python venv/conda prefix dynamically for the prompt
_jezek_venv_prefix() {
  local prefix=""
  if [[ -n "$VIRTUAL_ENV" ]]; then
    prefix="🐍[$(basename "$VIRTUAL_ENV")] "
  elif [[ -n "$CONDA_DEFAULT_ENV" ]]; then
    prefix="🐍[${CONDA_DEFAULT_ENV}] "
  fi
  echo "$prefix"
}

_jezek_print_right_line() {
  local color="$1"
  local text="$2"
  local columns=${COLUMNS:-80}
  local pad=$(( columns - ${#text} - 1 ))
  if (( pad < 0 )); then
    pad=0
  fi

  local spaces
  spaces=$(printf '%*s' "$pad" '')
  print -P -- "${spaces}%F{${color}}${text}%f"
}

_jezek_print_status_line() {
  local color="$1"
  local left="$2"
  local right="$3"
  local columns=${COLUMNS:-80}
  local pad=$(( columns - ${#left} - ${#right} - 1 ))
  if (( pad < 1 )); then
    pad=1
  fi

  local spaces
  spaces=$(printf '%*s' "$pad" '')
  print -P -- "%F{${color}}${left}${spaces}${right}%f"
}

_jezek_refresh_prompt() {
  # Refresh prompt safely after a terminal resize while editing a command line.
  if zle >/dev/null 2>&1; then
    zle reset-prompt
  fi
}

# Store command start and print start timestamp on the right.
jezek_preexec() {
  JEZEK_CMD_START=$EPOCHREALTIME
  _jezek_print_right_line "green" "$(date +"[%H:%M:%S]")"
}

# Print end-of-command time and duration on the right.
jezek_precmd() {
  local exit_code=$?
  local TIME
  TIME=$(date +"[%H:%M:%S]")

  local DUR=""
  if [[ -n "$JEZEK_CMD_START" ]]; then
    local elapsed=$(( EPOCHREALTIME - JEZEK_CMD_START ))
    if (( elapsed >= 0 )); then
      DUR="$(_jezek_format_duration $elapsed)"
    fi
    unset JEZEK_CMD_START
  fi

  local TEXT
  if [[ -n "$DUR" ]]; then
    TEXT="${DUR} ${TIME}"
  else
    TEXT="${TIME}"
  fi

  local ERR=""
  if (( exit_code != 0 )); then
    ERR="${exit_code} ↵"
  fi

  _jezek_print_status_line "red" "${ERR}" "${TEXT}"
}

() {

local PR_USER PR_USER_OP PR_PROMPT PR_HOST

# Set user color and prompt symbol based on UID
if [[ $UID -ne 0 ]]; then
  # normal user
  PR_USER='%F{green}%n%f'
  PR_USER_OP='%F{green}%#%f'
  PR_PROMPT='%f$%f'
else
  # root
  PR_USER='%F{red}%n%f'
  PR_USER_OP='%F{red}%#%f'
  PR_PROMPT='%F{red}#%f'
fi

# Highlight host differently over SSH
if [[ -n "$SSH_CLIENT" || -n "$SSH2_CLIENT" ]]; then
  # over SSH
  PR_HOST='%F{red}%M%f'
else
   # local
  PR_HOST='%F{green}%M%f'
fi

local user_host="${PR_USER}%F{cyan}@${PR_HOST}"
local current_dir="%B%F{blue}%~%f%b"
local git_branch='$(git_prompt_info)'
local venv_prefix='$(_jezek_venv_prefix)'

# Detect container / distrobox and build prefix
local container_prefix=""
if [[ -n "$CONTAINER_ID" ]] || [[ -f /run/.containerenv ]]; then
  local _cname="${CONTAINER_ID:-$(hostname)}"
  container_prefix="📦[${_cname}] "
fi

PROMPT="${container_prefix}${venv_prefix}${user_host} ${current_dir} ${git_branch}
$PR_PROMPT "

ZSH_THEME_GIT_PROMPT_PREFIX="%F{yellow}‹"
ZSH_THEME_GIT_PROMPT_SUFFIX="› %f"

}

autoload -U add-zsh-hook
add-zsh-hook precmd jezek_precmd
add-zsh-hook preexec jezek_preexec
TRAPWINCH() { _jezek_refresh_prompt }
